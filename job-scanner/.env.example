# Gmail account to send the daily digest FROM.
# GMAIL_APP_PASSWORD is a 16-character app password, not your real Gmail
# password — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where the digest gets sent. Defaults to GMAIL_USER if left blank.
EMAIL_TO=
