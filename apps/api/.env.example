# Anthropic API key used by the tailoring pipeline (Messages API)
ANTHROPIC_API_KEY=

# Random 32+ byte shared secret. Clients send it as X-Resume-Agent-Token.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

PORT=3847

# Comma-separated allowed origins for CORS, e.g. chrome-extension://<extension-id>
API_ORIGIN_ALLOWLIST=

# Optional. Where tailored resumes get written. Defaults to ./tailored-resumes
# next to the repo root, which is fine locally but gets wiped on every
# redeploy/restart in a container. On Railway, point this at a mounted
# volume, e.g. /data/tailored-resumes.
TAILORED_RESUMES_DIR=
